# Copy to .env and fill in values. Never commit .env.

# --- LLM ---
# auto = use Claude if its key is set, else Gemini, else demo mode
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# Any Claude model id; used for every chat answer when ANTHROPIC_API_KEY is set
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# minimal | low | medium | high (lower = faster replies)
GEMINI_THINKING_LEVEL=low

# --- Authentication ---
# Required outside development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:3007
ENVIRONMENT=development

# --- AI memory: embeddings, chunking, semantic search ---
# Embeddings are separate from the chat LLM. "local" runs the model on the CPU
# (no API key). Changing EMBEDDING_MODEL needs a new collection + reindex (README).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Chunk size and overlap in characters (reindex documents after changing them)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Search results with cosine similarity below this are treated as not relevant
MIN_SIMILARITY_SCORE=0.15
# Knowledge uploads: size limit and storage directory (a Docker volume in compose)
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/storage

# --- Clone chat (RAG) ---
# Chunks retrieved per question, minimum similarity to use a chunk, and the
# maximum knowledge text sent to the model. 0.15 is measured for the default
# embedding model; 0.35 drops real matches (see README before raising it).
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.15
RAG_MAX_CONTEXT_CHARS=12000
MAX_CONVERSATION_MESSAGES=10
MAX_CHAT_MESSAGE_LENGTH=4000
CHAT_RATE_LIMIT_PER_MINUTE=20
# Per LLM request, and for a whole answer including provider retries
LLM_TIMEOUT_SECONDS=60
CHAT_RESPONSE_DEADLINE_SECONDS=90

# --- Long-term memory ---
# Approved memories used per question, minimum similarity, and the maximum
# memory text sent to the model. 0.25 is measured for the default embedding
# model; 0.40 drops real matches (see README before raising it).
MEMORY_TOP_K=5
MEMORY_SCORE_THRESHOLD=0.25
MEMORY_MAX_CONTEXT_CHARS=5000
# Longest memory, and the similarity at which two memories count as the same fact
MEMORY_MAX_LENGTH=1000
MEMORY_DUPLICATE_THRESHOLD=0.85

# --- Voice (speech-to-text and text-to-speech) ---
# "auto" uses Gemini when a key is available; "none" turns voice off.
# STT_API_KEY / TTS_API_KEY default to GEMINI_API_KEY when left empty.
STT_PROVIDER=auto
STT_API_KEY=
STT_MODEL=gemini-3.5-flash-lite
STT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
TTS_PROVIDER=auto
TTS_API_KEY=
TTS_MODEL=gemini-3.8-flash-lite-tts
# Tried in order when the model before is busy or out of quota. Free-tier TTS models
# allow only about 10 requests a day each; when all are used up, the chat reads
# answers with the browser's own voice instead.
TTS_FALLBACK_MODELS=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
# Default prebuilt voice (Kore, Puck, Charon, Aoede, Leda, Orus, Zephyr, Achird, Sulafat, Fenrir)
TTS_VOICE=Kore
TTS_MAX_CHARACTERS=2500
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=60
VOICE_TIMEOUT_SECONDS=60
VOICE_RATE_LIMIT_PER_MINUTE=10
# Generated speech ({UPLOAD_DIR}/voice) is deleted after this many hours
VOICE_AUDIO_RETENTION_HOURS=24

# --- Personal voice clone (ElevenLabs Instant Voice Cloning) ---
# Lets an owner clone their own voice (with consent); replies, avatar videos and live
# calls then speak with it. Leave the key empty to turn cloning off (prebuilt voices only).
# Needs a paid ElevenLabs plan with voice cloning (Starter or higher). Never commit the key.
ELEVENLABS_API_KEY=
# eleven_v3: most expressive, 70+ languages incl. Urdu. eleven_flash_v2_5: lower latency.
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_API_URL=https://api.elevenlabs.io
# Total length of the recordings for one cloned voice (seconds), and how many files.
VOICE_CLONE_MIN_SECONDS=30
VOICE_CLONE_MAX_SECONDS=300
VOICE_CLONE_MAX_FILES=5
# Which service clones voices: auto (ElevenLabs if ELEVENLABS_API_KEY is set, else the local
# service if LOCAL_VOICE_CLONE_URL is set, else off), elevenlabs, local or none.
VOICE_CLONE_PROVIDER=auto
# Free self-hosted voice cloning (Chatterbox Multilingual, open source, MIT). Start it with
#   docker compose --profile voice-clone up -d voice-clone
# then set LOCAL_VOICE_CLONE_URL=http://voice-clone:8100. Recordings stay on this server
# (unless you use the Colab GPU below).
# CPU-only speech is slow (5-30+ s per sentence); Urdu is spoken with the Hindi model.
LOCAL_VOICE_CLONE_URL=
# Optional shared secret sent as X-Service-Token (must match the voice-clone service's token).
VOICE_CLONE_SERVICE_TOKEN=
# Longest wait for one spoken answer from the local service (seconds).
LOCAL_VOICE_CLONE_TIMEOUT_SECONDS=300
# Optional second service (scripts/voice-gpu.ps1 sets both): LOCAL_VOICE_CLONE_URL is then
# the Colab GPU (recordings are stored on its Google Drive) and this is the laptop service,
# used when the GPU is off. Voices are stored on, and deleted from, both.
LOCAL_VOICE_CLONE_FALLBACK_URL=
# Gemini rewrites Urdu replies in the script the voice engine reads (Devanagari or Urdu)
# for better pronunciation; this sends the reply text to Gemini. false = rule-based only.
VOICE_LLM_TRANSLITERATION=true
VOICE_TRANSLITERATION_MODEL=gemini-3.1-flash-lite
VOICE_TRANSLITERATION_TIMEOUT_SECONDS=15

# --- Avatar (talking-avatar videos) ---
# LIPSYNC_PROVIDER: "fal" (photo-realistic, cloud, paid - see FAL_* below),
# "local" (built in, runs on the CPU, no GPU or download; cartoon-style mouth),
# "http" (your own lip-sync server, e.g. Wav2Lip/SadTalker/MuseTalk on a GPU, at
# LIPSYNC_API_URL), or "none". AVATAR_ENABLED=false turns avatars off entirely.
AVATAR_ENABLED=true
MAX_AVATAR_SIZE_MB=10
LIPSYNC_PROVIDER=local
LIPSYNC_API_URL=
LIPSYNC_API_KEY=
LIPSYNC_TIMEOUT_SECONDS=300
# Photo-realistic videos (LIPSYNC_PROVIDER=fal): a cloud model on fal.ai animates the
# real photo. Paid per second of video (Fabric 1.0: ~$0.08/s at 480p, ~$0.15/s at 720p).
# The avatar photo and the spoken answer are sent to fal.ai. Key: https://fal.ai/dashboard/keys
FAL_API_KEY=
# veed/fabric-1.0 (most realistic) | veed/fabric-1.0/fast | fal-ai/sadtalker | fal-ai/infinitalk
FAL_LIPSYNC_MODEL=veed/fabric-1.0
FAL_LIPSYNC_RESOLUTION=480p

# --- Live video call (Simli) ---
# Face-to-face calls with the clone: the avatar is streamed live (blinks, moves,
# lip-syncs the clone's voice). Free plan ~50 min/month, then ~$0.01/min.
# Key: https://app.simli.com (API key). The avatar photo is sent to Simli once.
SIMLI_API_KEY=
LIVE_CALL_MAX_MINUTES=10
LIVE_CALL_MAX_IDLE_SECONDS=120
LIVE_CALL_RATE_LIMIT_PER_MINUTE=3
MAX_VIDEO_DURATION_SECONDS=60
VIDEO_RETENTION_HOURS=24
AVATAR_VIDEO_RATE_LIMIT_PER_MINUTE=3
AVATAR_VIDEO_WORKERS=1
AVATAR_VIDEO_FPS=25

# --- Public clones (/c/{slug}, visitors without an account) ---
# Only content the owner marks public is used. These limit cost and abuse.
PUBLIC_SESSION_TTL_HOURS=24
MAX_PUBLIC_MESSAGES_PER_SESSION=50
MAX_PUBLIC_MESSAGE_LENGTH=4000
PUBLIC_CHAT_RATE_LIMIT_PER_MINUTE=10
PUBLIC_VOICE_RATE_LIMIT_PER_MINUTE=5
PUBLIC_AVATAR_RATE_LIMIT_PER_MINUTE=2
PUBLIC_SESSION_RATE_LIMIT_PER_MINUTE=10
PUBLIC_MAX_OUTPUT_TOKENS=1000
# Claude model for public chat; empty = CLAUDE_MODEL (same client, no second key)
PUBLIC_CLAUDE_MODEL=
PUBLIC_RAG_TOP_K=5
PUBLIC_RAG_MAX_CONTEXT_CHARS=8000
# Optional challenge (Turnstile, hCaptcha, reCAPTCHA... any "siteverify" service)
PUBLIC_CAPTCHA_ENABLED=false
PUBLIC_CAPTCHA_VERIFY_URL=
PUBLIC_CAPTCHA_SECRET=
# Behind a trusted reverse proxy, use X-Forwarded-For for visitor rate limits.
# Only the last entry (added by your proxy) is used; the proxy must append the client IP.
TRUST_PROXY_HEADERS=false
# Address used in share links (default: FRONTEND_URL)
PUBLIC_SITE_URL=

# --- Administration, security and monitoring (Phase 10) ---
# Admins are created on the server, never through the API:
#   docker compose exec backend python -m app.cli create-admin --email you@example.com
# Or: an existing account with this email becomes admin at startup while no admin exists.
INITIAL_ADMIN_EMAIL=
# Login attempts per minute (per email; per address it's 4x this).
LOGIN_RATE_LIMIT_PER_MINUTE=5
# After this many failed logins in a row, the account waits LOGIN_LOCKOUT_MINUTES (temporary).
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
# Days to keep operational logs (the admin audit log is kept).
SECURITY_LOG_RETENTION_DAYS=30
USAGE_LOG_RETENTION_DAYS=90
ERROR_LOG_RETENTION_DAYS=30
# Optional prices for cost ESTIMATES in /admin/usage (empty = usage only, no cost).
# Units: estimated token (LLMs), audio second (STT), character (TTS).
CLAUDE_INPUT_COST_PER_UNIT=
CLAUDE_OUTPUT_COST_PER_UNIT=
GEMINI_INPUT_COST_PER_UNIT=
GEMINI_OUTPUT_COST_PER_UNIT=
STT_COST_PER_UNIT=
TTS_COST_PER_UNIT=
# Per second of avatar video from a paid lip-sync provider (fal 480p: 0.08)
LIPSYNC_COST_PER_UNIT=
# Per minute of live video call (Simli ~0.01)
LIVE_CALL_COST_PER_UNIT=

# --- Host ports (change if something else already uses them) ---
POSTGRES_PORT=5432
QDRANT_PORT=6333
BACKEND_PORT=8000
FRONTEND_PORT=3007

# --- PostgreSQL ---
POSTGRES_USER=clone
POSTGRES_PASSWORD=clone
POSTGRES_DB=ai_clone
# Used when running the backend outside Docker. docker-compose.yml overrides it
# to point at the "postgres" service.
DATABASE_URL=postgresql+psycopg://clone:clone@localhost:5432/ai_clone

# --- Qdrant ---
# docker-compose.yml overrides this to http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Document knowledge chunks, and approved long-term memories (separate collections)
QDRANT_COLLECTION=clone_memories
QDRANT_MEMORY_COLLECTION=clone_long_term_memories

# --- Backend ---
CORS_ORIGINS=http://localhost:3007
LOG_LEVEL=INFO

# --- Frontend (baked in at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Billing (Phase 12) ---
# false = everyone on free-mode limits; no payment provider is called.
BILLING_ENABLED=false
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
BILLING_CURRENCY=USD
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
ANALYTICS_RETENTION_DAYS=90

# --- Developer platform (Phase 14) ---
# Per API key. With billing on, a plan's api_rate_limit_per_minute replaces the per-minute value.
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000
API_RATE_LIMIT_BURST=10
API_MAX_KEY_EXPIRY_DAYS=365
# Browser origins allowed to call /api/v1 directly (comma-separated, no cookies). Empty = server-to-server only.
API_ALLOWED_ORIGINS=
WEBHOOK_DELIVERY_ENABLED=true
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10
# Failed attempts in a row before a webhook is switched off (0 = never)
WEBHOOK_AUTO_DISABLE_AFTER=20
# Base URL shown in the developer docs (default: the API's own address)
PUBLIC_API_URL=

# --- AI agent (Phase 16) ---
# Controlled multi-step agent with approved tools only (no shell, code, files, database
# or environment access). Off by default; each clone's owner must also enable it.
AGENT_ENABLED=false
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_EXECUTION_TIME_SECONDS=60
AGENT_MAX_CONTEXT_CHARS=16000
AGENT_MAX_TOOL_RETRIES=2
AGENT_WEB_SEARCH_ENABLED=false
# Name of a registered web search provider (none is built in, so web search stays unavailable)
AGENT_WEB_SEARCH_PROVIDER=
AGENT_DEFAULT_CONFIRMATION_REQUIRED=true

# --- Phase 17: real-time voice conversations ------------------------------------
# Live voice calls with a clone over a WebSocket (docs/phase17/). Off by default.
REALTIME_VOICE_ENABLED=false
# "pipeline": this platform's own speech-to-text, the clone's chat pipeline (Claude/Gemini,
# knowledge, approved memories) and its voice, spoken sentence by sentence. No extra service
# or key: it uses the STT/TTS/LLM settings above. (No hosted WebRTC provider is built in.)
REALTIME_VOICE_PROVIDER=pipeline
# A created session must be connected within this time (its ticket lives at most 60 s).
REALTIME_VOICE_SESSION_TTL_SECONDS=600
# Longest conversation; the server ends it after this.
REALTIME_VOICE_MAX_DURATION_SECONDS=600
# Live sessions per user (or public visitor) at once.
REALTIME_VOICE_MAX_CONCURRENT_SESSIONS=1
# New sessions per user (or visitor address) per minute.
REALTIME_VOICE_RATE_LIMIT_PER_MINUTE=5
# Origins allowed to open the WebSocket (comma-separated); empty = CORS_ORIGINS + FRONTEND_URL.
REALTIME_VOICE_ALLOWED_ORIGINS=
# Real-time audio is never stored. Retention isn't implemented; keep this false.
REALTIME_VOICE_AUDIO_RETENTION_ENABLED=false
# One spoken utterance (the browser cuts speech at pauses).
REALTIME_VOICE_MAX_UTTERANCE_BYTES=2000000
REALTIME_VOICE_MAX_UTTERANCE_SECONDS=30

# --- Marketplace & discovery (Phase 18) -----------------------------------------
# Public marketplace requests per minute per client address (list, search, profiles).
MARKETPLACE_RATE_LIMIT_PER_MINUTE=120
# Clone reports per hour per user (or per address for anonymous reports).
MARKETPLACE_REPORTS_PER_HOUR=5
