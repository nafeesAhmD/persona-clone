# Production settings for docker-compose.prod.yml.
#   cp .env.production.example .env.production   (never commit .env.production)
# Every value below is a PLACEHOLDER. Generate real secrets, e.g.:
#   openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
# Full reference: docs/ENVIRONMENT_VARIABLES.md

# --- Domain and HTTPS (Caddy) --------------------------------------------------
DOMAIN=your-domain.example
ACME_EMAIL=you@your-domain.example
# Public origin of the API as browsers see it (same domain: Caddy routes /api/*).
PUBLIC_API_URL=https://your-domain.example
IMAGE_TAG=latest

# --- Application ----------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
# Swagger/OpenAPI pages (off in production unless you need them).
API_DOCS_ENABLED=false
# Host headers the API accepts (comma-separated). Keep backend,localhost,127.0.0.1:
# the container healthcheck and the frontend's server-side calls use those names.
ALLOWED_HOSTS=your-domain.example,backend,localhost,127.0.0.1
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
PUBLIC_SITE_URL=https://your-domain.example
# Migrations run in the one-shot `migrate` service (docker-compose.prod.yml sets this
# per service: true for migrate, false for backend); this value is only a default.
RUN_MIGRATIONS_ON_START=false
# Caddy is the only proxy in front of the backend (Docker network address range).
FORWARDED_ALLOW_IPS=*
# Read the client address from X-Forwarded-For (set by Caddy) for rate limits and logs.
TRUST_PROXY_HEADERS=true

# --- Authentication -------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# An existing account (by email) becomes administrator while there is none.
INITIAL_ADMIN_EMAIL=

# --- PostgreSQL -----------------------------------------------------------------
POSTGRES_DB=ai_clone
# Superuser: administration and backups only.
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# The application's own login (created by deploy/postgres/init-app-user.sh).
POSTGRES_APP_USER=ai_clone_app
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_MAX_CONNECTIONS=100
# Per backend process: pool + overflow must stay below POSTGRES_MAX_CONNECTIONS.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=30000

# --- Qdrant ---------------------------------------------------------------------
QDRANT_API_KEY=CHANGE_ME

# --- AI providers (at least one LLM key) -----------------------------------------
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Optional features ----------------------------------------------------------
# Real-time voice (Phase 17): needs HTTPS (microphone) and WebSockets through Caddy.
REALTIME_VOICE_ENABLED=false
# Self-hosted voice cloning (--profile voice-clone).
VOICE_CLONE_SERVICE_TOKEN=
LOCAL_VOICE_CLONE_URL=
ELEVENLABS_API_KEY=
SIMLI_API_KEY=
FAL_API_KEY=

# --- Resource limits (docker-compose.prod.yml) ------------------------------------
BACKEND_MEM_LIMIT=3g
FRONTEND_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=1g
QDRANT_MEM_LIMIT=1g
